NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:3000
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/jobpilot?retryWrites=true&w=majority
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d
GOOGLE_CLIENT_ID=replace_when_oauth_is_configured
GOOGLE_CLIENT_SECRET=replace_when_oauth_is_configured
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback
GMAIL_REDIRECT_URI=http://localhost:5000/api/gmail/callback
CLOUDINARY_CLOUD_NAME=replace_when_cloudinary_is_configured
CLOUDINARY_API_KEY=replace_when_cloudinary_is_configured
CLOUDINARY_API_SECRET=replace_when_cloudinary_is_configured
